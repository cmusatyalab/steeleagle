# gabriel-server
GABRIEL_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ gabriel_image_tag }}{% endif %}
GABRIEL_TOKENS={{ gabriel_tokens }}

# globals

#leaving STORE unassigned (STORE=) will prevent images from being written to disk by engines
STORE={% if store_imagery  %}--store{% else %} {% endif %}

# aruco-engine
ARUCO_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ aruco_image_tag }}{% endif %}

# telemetry-engine
TELEMETRY_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ telemetry_image_tag }}{% endif %}

#obstacle avoidance engine
OBSTACLE_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ obstacle_image_tag }}{% endif %}
DEPTH_THRESHOLD={{ depth_threshold }}
# comment to use MiDaS instead of Metric3d  for avoidance
USE_METRIC3D={% if use_metric3d %}--metric3d{% else %} {% endif %}
# ['metric3d_vit_small', 'metric3d_vit_large', 'metric3d_vit_giant2', 'metric3d_convnext_large' ]
DEPTH_MODEL={{ depth_model }}

#object detection engine
OBJECT_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ object_image_tag }}{% endif %}
#left-hand side of pytorch model located in steeleagle/backend/server/models dir
DNN={{ detection_model}}
# confidence threshold for detections
OBJ_THRESHOLD={{ detection_threshold }}
#comma-separated list of class ids to exclude from consideration
EXCLUSIONS={{ exclusions }}
# threshold for HSV color filtering of detections
HSV_THRESHOLD={{ hsv_threshold }}
# number of seconds to keep a detected object in redis (refreshed if each time it is detected)
OBJECT_TTL={{ object_ttl }}
# enable geofence (omit to disable)
GEOFENCE_ENABLED={%if geofence  %}--geofence_enabled{% else %} {% endif %}
# objects detected outside of this geofence will not be returned to vehicles nor logged in redis
GEOFENCE_FILE={{ geofence_file }}
# radius in meters used to distinguish between different objects
OBJECT_RADIUS={{ object_diff_radius }}

#slam engine
SLAM_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ slam_image_tag }}{% endif %}
TERRASLAM_HOST={{ terraslam_host }}

#swiftmap engine
SWIFTMAP_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ swiftmap_image_tag }}{% endif %}
SWIFTMAP_HOST={{ swiftmap_host }} # in-network hostname of the swiftmap-server service (below)
SWIFTMAP_PORT={{ swiftmap_port }}
SWIFTMAP_SEND_DISTANCE={{ swiftmap_send_distance }} # forward one frame+GPS pair per this many meters of drone travel (0 = every frame)

#swiftmap server (headless VGGT mapping server; build image from the swift_map repo)
SWIFTMAP_SERVER_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ swiftmap_server_image_tag }}{% endif %}
SWIFTMAP_BACKBONE={{ swiftmap_backbone }} # reconstruction model: vggt | vggt_omega
SWIFTMAP_SEGMENTER={{ swiftmap_segmenter }}
SWIFTMAP_SITE={{ swiftmap_site }} # map-tag prefix (drone / site name)
SWIFTMAP_MAX_KEYFRAMES={{ swiftmap_max_keyframes }} # pipeline auto-runs when this many keyframes are retained
SWIFTMAP_CONF_THRESHOLD={{ swiftmap_conf_threshold }}
SWIFTMAP_MERGE_VOXEL={{ swiftmap_merge_voxel }} # grow-merge voxel size in meters (near-duplicate collapse; 0 = off)
SWIFTMAP_MASK_SKY={{ swiftmap_mask_sky | lower }}
SWIFTMAP_KEEP_ALL={{ swiftmap_keep_all | lower }} # keep every received pair as a keyframe (skip server-side selection)
SWIFTMAP_VIEWER_PORT={{ swiftmap_viewer_port }} # host port for the results viewer + segment-request UI
VGGT_OMEGA_CHECKPOINT={{ vggt_omega_checkpoint }} # only for vggt_omega
SAM3_CHECKPOINT={{ sam3_checkpoint }}

#swarm controller
SC_IMAGE_TAG={% if one_tag_to_rule_them_all %}{{ one_tag }}{% else %}{{ sc_image_tag }}{% endif %}

#http server
HTTP_PORT={{ webserver_port }}
WEBSERVER_URL=http://{{ webserver_url }}

#redis
REDIS_VERSION=6.2.6-v10
#shared key for the redis user
REDIS_AUTH={{ redis_pw }}
#for redis-stack browser; change to 0.0.0.0 to allow external access
REDIS_HOST=127.0.0.1
GRAFANA_PWD={{ grafana_pwd }}

# Team Awareness Kit
COT_URL={{ cot_url }}

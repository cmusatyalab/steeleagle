{
  "title": "Gabriel flight",
  "uid": "gabriel-flight",
  "description": "Live view of a vehicle's Gabriel flow and the cloudlet's engines.",
  "editable": true,
  "schemaVersion": 42,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "gabriel"
  ],
  "templating": {
    "list": [
      {
        "name": "window",
        "label": "Rate window",
        "type": "interval",
        "query": "15s,30s,1m,5m,15m",
        "auto": false,
        "refresh": 2,
        "current": {
          "text": "30s",
          "value": "30s"
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": false
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": true
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Drone (eagled)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Scrape targets up",
      "description": "Whether Prometheus reached each target at its last scrape. The drone going down while flying usually means the link dropped.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=~\"eagled|gabriel-server\"}",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inputs published per second",
      "description": "",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (producer_id) (rate(gabriel_producer_inputs_published_total{job=\"eagled\"}[$window]))",
          "legendFormat": "{{producer_id}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Results per second",
      "description": "Results the drone got from each engine, local or remote.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (engine_id) (rate(gabriel_engine_outcomes_total{job=\"eagled\", outcome=~\"result|late_result\"}[$window]))",
          "legendFormat": "{{engine_id}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Result age on the drone",
      "description": "From publishing an input to its result reaching the drone. For a remote engine, this includes the uplink and the downlink.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, engine_id) (rate(gabriel_client_input_processing_latency_seconds_bucket{job=\"eagled\"}[$window])))",
          "legendFormat": "{{engine_id}} p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, engine_id) (rate(gabriel_client_input_processing_latency_seconds_bucket{job=\"eagled\"}[$window])))",
          "legendFormat": "{{engine_id}} p95",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Offers ended without a timely result",
      "description": "skipped: replaced by a newer input before it was sent. timed_out: no answer in time. late_result: an answer after the timeout.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (engine_id, outcome) (rate(gabriel_engine_outcomes_total{job=\"eagled\", outcome=~\"skipped|timed_out|late_result\"}[$window]))",
          "legendFormat": "{{engine_id}} {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disconnects and lost events",
      "description": "",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (producer_id) (increase(gabriel_disconnects_total{job=\"eagled\"}[$window]))",
          "legendFormat": "{{producer_id}} disconnects",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (producer_id) (increase(gabriel_events_lost_total{job=\"eagled\"}[$window]))",
          "legendFormat": "{{producer_id}} events lost",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cloudlet (gabriel-server)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Engine processing time",
      "description": "From sending an input to the engine to its result, on the cloudlet.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, engine_id) (rate(gabriel_engine_processing_latency_seconds_bucket{job=\"gabriel-server\"}[$window])))",
          "legendFormat": "{{engine_id}} p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, engine_id) (rate(gabriel_engine_processing_latency_seconds_bucket{job=\"gabriel-server\"}[$window])))",
          "legendFormat": "{{engine_id}} p95",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Engine wait",
      "description": "How long an input that reached the cloudlet waited for its engine to be free.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le, engine_id) (rate(gabriel_engine_wait_seconds_bucket{job=\"gabriel-server\"}[$window])))",
          "legendFormat": "{{engine_id}} p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, engine_id) (rate(gabriel_engine_wait_seconds_bucket{job=\"gabriel-server\"}[$window])))",
          "legendFormat": "{{engine_id}} p95",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Engine inputs and outcomes per second",
      "description": "",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (engine_id) (rate(gabriel_engine_inputs_received_total{job=\"gabriel-server\"}[$window]))",
          "legendFormat": "{{engine_id}} received",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (engine_id, outcome) (rate(gabriel_engine_outcomes_total{job=\"gabriel-server\"}[$window]))",
          "legendFormat": "{{engine_id}} {{outcome}}",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Engine busy fraction",
      "description": "The fraction of time each engine spends on inputs. Near 1, the engine is the bottleneck.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (engine_id) (rate(gabriel_engine_processing_latency_seconds_sum{job=\"gabriel-server\"}[$window]))",
          "legendFormat": "{{engine_id}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ]
}

[Unit]
Description=SteelEagle vehicle daemon (eagled)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Prometheus metrics: eagled's on 8001 (the port the old Gabriel client
# used), and Gabriel's own on 9464 (the OpenTelemetry Prometheus exporter's).
ExecStart=/usr/local/bin/eagled -metrics-port 8001 -gabriel-metrics-port 9464
User=eagled
Group=eagled
WorkingDirectory=/var/lib/eagled
# GetDataHome() (persisted config/state) falls back to $HOME/.local/share
# when $XDG_DATA_HOME is unset.
Environment=HOME=/var/lib/eagled
# GetPluginDir() eeds $XDG_RUNTIME_DIR, which systemd doesn't set for system
# services. RuntimeDirectory creates /run/eagled with the right ownership.
RuntimeDirectory=eagled
RuntimeDirectoryPreserve=restart
Environment=XDG_RUNTIME_DIR=/run/eagled
EnvironmentFile=-/etc/eagled/eagled.env
# always, not on-failure: ResetConfig exits 0 on purpose to relaunch
# unconfigured.
Restart=always
RestartSec=5s

NoNewPrivileges=true
ProtectSystem=strict
# Not ProtectHome=true: aviary.dir/aviary.command in a pushed config.toml are
# arbitrary admin-supplied paths and commands (e.g. a driver checkout under a
# developer's home directory), so eagled needs to be able to reach anywhere
# it's told to, not just /var/lib/eagled. Configure already implies that
# trust -- it can already run any command eagled's uid can reach.
# /tmp, and not PrivateTmp=true: Gabriel (iceoryx2) keeps its services in
# /tmp/iceoryx2, and a private /tmp would hide the vehicles' Gabriel servers
# from local engines that run outside this unit, e.g. an inference server on
# the NPU. Its shared memory is in /dev/shm, which ProtectSystem leaves
# writable.
ReadWritePaths=/var/lib/eagled /tmp

[Install]
WantedBy=multi-user.target

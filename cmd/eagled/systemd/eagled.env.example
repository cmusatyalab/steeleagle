# Sourced by eagled.service (EnvironmentFile=-/etc/eagled/eagled.env).  Copy to
# /etc/eagled/eagled.env and edit as needed; install.sh does this for you on
# first install and leaves an existing file untouched.

# Reusable Tailscale auth key eagled's own tsnet node joins with. This env var
# name is fixed, not configurable. Leave unset to fall back to tsnet's
# interactive login flow.
#TS_AUTHKEY=

# Optional separate auth key for vehicles' own tsnet nodes. This env var name
# is fixed too; leave unset to have vehicles reuse TS_AUTHKEY.
#TS_VEHICLE_AUTHKEY=

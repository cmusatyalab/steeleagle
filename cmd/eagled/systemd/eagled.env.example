# Sourced by eagled.service (EnvironmentFile=-/etc/eagled/eagled.env).  Copy to
# /etc/eagled/eagled.env and edit as needed; install.sh does this for you on
# first install and leaves an existing file untouched.

# Reusable Tailscale auth key. Its name must match the [tailscale].authkey-env
# key in whatever config gets pushed via `eagle configure` (default:
# TS_AUTHKEY). Leave unset to fall back to tsnet's interactive login flow.
#TS_AUTHKEY=

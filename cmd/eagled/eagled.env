# Environment of the eagled user service, read from
# ~/.config/steeleagle/eagled.env. Keep it readable only by you (chmod 600),
# since it holds the VPN auth key. Run `systemctl --user restart eagled`
# after changing it.

# Flags passed to eagled, e.g. "-log-level debug" or "-config /path/to/config.toml"
EAGLED_ARGS=

# Auth key to join the VPN non-interactively; leave empty to log in
# interactively (the login URL is printed to the journal)
STEELEAGLE_AUTH_KEY=

{
    "actions": {
        "actions.GoToGlobalPosition": {
            "comment": "GoToGlobalPosition orders the vehicle to transit to a global\nposition.",
            "fields": [
                {
                    "name": "Position",
                    "type": "datatypes.GlobalPosition"
                }
            ],
            "optFields": [
                {
                    "name": "HeadingMode",
                    "type": "enums.HeadingMode"
                },
                {
                    "name": "AltitudeMode",
                    "type": "enums.AltitudeMode"
                },
                {
                    "name": "Speed",
                    "type": "float32"
                },
                {
                    "name": "AngularSpeed",
                    "type": "float32"
                }
            ],
            "type": "actions.GoToGlobalPosition"
        },
        "actions.GoToRelativePosition": {
            "comment": "GoToRelativePosition orders the vehicle to transit to a relative\nposition.",
            "fields": [
                {
                    "name": "Position",
                    "type": "datatypes.RelativePosition"
                }
            ],
            "optFields": [
                {
                    "name": "Speed",
                    "type": "float32"
                },
                {
                    "name": "AngularSpeed",
                    "type": "float32"
                },
                {
                    "name": "Frame",
                    "type": "enums.ReferenceFrame"
                }
            ],
            "type": "actions.GoToRelativePosition"
        },
        "actions.Hold": {
            "comment": "Hold orders the vehicle to hold/loiter at its current position,\ncancelling any ongoing movement command.",
            "fields": [],
            "type": "actions.Hold"
        },
        "actions.Land": {
            "comment": "Land orders the vehicle to land at its current position.",
            "fields": [],
            "type": "actions.Land"
        },
        "actions.Patrol": {
            "comment": "Patrol orders the vehicle to fly the waypoints of a patrol pattern over\nArea at Altitude: a corridor scan around its exterior (the default), or a\nsurvey over its interior.",
            "fields": [
                {
                    "comment": "polygon to patrol around",
                    "name": "Area",
                    "type": "params.Polygon"
                },
                {
                    "comment": "altitude for each point in patrol",
                    "name": "Altitude",
                    "type": "float32"
                }
            ],
            "optFields": [
                {
                    "comment": "how to interpret altitude, MSL or above take off",
                    "name": "AltitudeMode",
                    "type": "enums.AltitudeMode"
                },
                {
                    "comment": "mode for patrol, either survey or corridor (corridor by default)",
                    "name": "Pattern",
                    "type": "actions.PatrolMode"
                },
                {
                    "comment": "survey spacing (default to 10.0m, only used in survey mode)",
                    "name": "SurveySpacing",
                    "type": "float32",
                    "value": "10.0"
                },
                {
                    "comment": "survey heading (default to 0.0deg, only used in survey mode)",
                    "name": "SurveyHeading",
                    "type": "float32"
                },
                {
                    "name": "Speed",
                    "type": "float32",
                    "value": "3.0"
                },
                {
                    "name": "AngularSpeed",
                    "type": "float32",
                    "value": "120.0"
                }
            ],
            "type": "actions.Patrol"
        },
        "actions.ReturnToHome": {
            "comment": "ReturnToHome orders the vehicle to return to its start position.",
            "fields": [],
            "optFields": [
                {
                    "name": "EndBehavior",
                    "type": "enums.ReturnToHomeEndBehavior"
                },
                {
                    "name": "MinReturnAltitude",
                    "type": "float32"
                },
                {
                    "name": "FinalAltitude",
                    "type": "float32"
                }
            ],
            "type": "actions.ReturnToHome"
        },
        "actions.SetGimbalPose": {
            "comment": "SetGimbalPose orders the vehicle to set the pose of its primary\ngimbal.",

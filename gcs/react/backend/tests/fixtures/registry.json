                {
                    "name": "Pose",
                    "type": "datatypes.Pose"
                }
            ],
            "optFields": [
                {
                    "name": "AngleMode",
                    "type": "enums.AngleMode"
                },
                {
                    "name": "Frame",
                    "type": "enums.ReferenceFrame"
                }
            ],
            "type": "actions.SetGimbalPose"
        },
        "actions.SetGimbalVelocity": {
            "comment": "SetGimbalVelocity orders the vehicle to actuate its primary gimbal at\na target angular velocity.",
            "fields": [
                {
                    "name": "PoseVelocity",
                    "type": "datatypes.PoseVelocity"
                }
            ],
            "type": "actions.SetGimbalVelocity"
        },
        "actions.SetVelocity": {
            "comment": "SetVelocity orders the vehicle to accelerate towards a target velocity.",
            "fields": [
                {
                    "name": "Velocity",
                    "type": "datatypes.Velocity"
                }
            ],
            "optFields": [
                {
                    "name": "Frame",
                    "type": "enums.ReferenceFrame"
                }
            ],
            "type": "actions.SetVelocity"
        },
        "actions.TakeOff": {
            "comment": "TakeOff orders the vehicle to take off at its current position.",
            "fields": [],
            "optFields": [
                {
                    "name": "Altitude",
                    "type": "float32"
                }
            ],
            "type": "actions.TakeOff"
        },
        "actions.Wait": {
            "comment": "Wait orders the vehicle to hold at its current position for Duration\nseconds.",
            "fields": [
                {
                    "comment": "seconds to wait",
                    "name": "Duration",
                    "type": "float32"
                }
            ],
            "type": "actions.Wait"
        }
    },

    "events": {
        "events.AltitudeReached": {
            "comment": "AltitudeReached fires once the vehicle's altitude is within Tolerance of\nAltitude. AltitudeMode selects which telemetry altitude to compare\nagainst: AltitudeModeAbsolute reads global (MSL) altitude,\nAltitudeModeRelative reads altitude relative to takeoff.",
            "fields": [
                {
                    "name": "Altitude",
                    "type": "float32"
                },
                {
                    "name": "AltitudeMode",
                    "type": "enums.AltitudeMode"
                }
            ],
            "optFields": [
                {
                    "name": "Tolerance",
                    "type": "float32",
                    "value": "0.5"
                }
            ],
            "type": "events.AltitudeReached"
        },
        "events.Battery": {
            "comment": "Battery fires once the vehicle's battery percentage satisfies Comparator\nagainst Threshold (e.g. LessOrEqual for a low-battery warning,\nGreaterOrEqual to detect a full charge).",
            "fields": [
                {
                    "name": "Comparator",
                    "type": "events.Comparator"
                }
            ],
            "optFields": [
                {
                    "comment": "battery percentage",
                    "name": "Threshold",
                    "type": "uint32",
                    "value": "20"
                }
            ],
            "type": "events.Battery"
        },
        "events.GimbalPoseReached": {
            "comment": "GimbalPoseReached fires once the vehicle's primary gimbal pose is\nwithin Tolerance of Target on every axis. Frame selects which\ntelemetry pose to compare against.",
            "fields": [
                {
                    "name": "Target",
                    "type": "datatypes.Pose"
                },
                {
                    "name": "Frame",
                    "type": "enums.ReferenceFrame"
                }
            ],
            "optFields": [
                {
                    "name": "Tolerance",
                    "type": "float32",
                    "value": "3.0"
                }
            ],
            "type": "events.GimbalPoseReached"
        },
        "events.GlobalPositionReached": {
            "comment": "GlobalPositionReached fires once the vehicle's global position is\nwithin tolerance of Target: Tolerance is a great-circle distance\n[meters] for latitude/longitude, AltitudeTolerance [meters] for\naltitude, and HeadingTolerance [degrees] for heading.",
            "fields": [
                {
                    "name": "Target",
                    "type": "datatypes.GlobalPosition"
                }
            ],
            "optFields": [
                {
                    "name": "Tolerance",
                    "type": "float32",
                    "value": "0.5"
                },
                {
                    "name": "AltitudeTolerance",
                    "type": "float32",
                    "value": "0.5"
                },
                {
                    "name": "HeadingTolerance",
                    "type": "float32",
                    "value": "3.0"
                }
            ],
            "type": "events.GlobalPositionReached"
        },
        "events.RelativePositionReached": {
            "comment": "RelativePositionReached fires once the vehicle's relative position is\nwithin tolerance of Target on every axis: Tolerance for X/Y/Z\n[meters], AngleTolerance for Angle [degrees].",
            "fields": [
                {
                    "name": "Target",
                    "type": "datatypes.RelativePosition"
                }
            ],
            "optFields": [
                {
                    "name": "Tolerance",
                    "type": "float32",
                    "value": "0.20"
                },
                {
                    "name": "AngleTolerance",
                    "type": "float32",
                    "value": "0"
                }
            ],
            "type": "events.RelativePositionReached"
        },
        "events.Satellites": {
            "comment": "Satellites fires once the vehicle's GPS satellite count satisfies\nComparator against Threshold (e.g. GreaterOrEqual to detect a GPS lock).",
            "fields": [
                {
                    "name": "Comparator",
                    "type": "events.Comparator"
                }
            ],
            "optFields": [
                {
                    "comment": "GPS satellite count",
                    "name": "Threshold",
                    "type": "uint32",
                    "value": "6"
                }
            ],
            "type": "events.Satellites"
        },
        "events.TimeElapsed": {
            "comment": "TimeElapsed fires once Duration seconds have passed since the state\nhosting this event was entered.",
            "fields": [
                {
                    "comment": "seconds to wait before firing",
                    "name": "Duration",
                    "type": "float32"
                }
            ],
            "type": "events.TimeElapsed"
        },
        "events.VelocityReached": {
            "comment": "VelocityReached fires once the vehicle's velocity is within Tolerance\nof Target on every axis. Frame selects which telemetry velocity to\ncompare against.",
            "fields": [
                {
                    "name": "Target",
                    "type": "datatypes.Velocity"
                },
                {
                    "name": "Frame",
                    "type": "enums.ReferenceFrame"
                }
            ],
            "optFields": [
                {
                    "name": "Tolerance",
                    "type": "float32",
                    "value": "0"
                }
            ],
            "type": "events.VelocityReached"
        }
    }
}

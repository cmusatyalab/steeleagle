        "events.Comparator": {
            "comment": "Comparator selects how a threshold-style event compares the current\ntelemetry value against its configured Threshold.",
            "fields": [
                {
                    "comment": "fires once the value rises to or above Threshold",
                    "name": "GreaterOrEqual",
                    "type": "events.Comparator",
                    "value": "GreaterOrEqual"
                },
                {
                    "comment": "fires once the value drops to or below Threshold",
                    "name": "LessOrEqual",
                    "type": "events.Comparator",
                    "value": "LessOrEqual"
                }
            ],
            "type": "events.Comparator"
        },
